<?xml version="1.0" ?>
<sdf version="1.6">
  <model name='lettuce_02'>
    <pose frame=''>0 0 0.01 0 -0 0</pose>
    <link name='lettuce_02_link'>
      <inertial>
        <pose>0 0 0.03 0 0 0</pose>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.0012</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0012</iyy>
          <iyz>0</iyz>
          <izz>0.0018</izz>
        </inertia>
      </inertial>
      <!-- the firm middle of the head: the outer leaves do not stop a wheel -->
      <collision name='collision'>
        <pose>0 0 0.04 0 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.066</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact>
            <ode/>
          </contact>
          <bounce/>
          <friction>
            <ode>
              <mu>10</mu>
              <mu2>10</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://lettuce_02/meshes/lettuce_02.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
    </link>
  </model>
</sdf>
