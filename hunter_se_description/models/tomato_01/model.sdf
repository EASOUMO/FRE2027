<?xml version="1.0" ?>
<sdf version="1.6">
  <model name='tomato_01'>
    <pose frame=''>0 0 0.02 0 -0 0</pose>
    <link name='tomato_01_link'>
      <!-- Light plant on a heavy foot, so that it stands on the heightmap but
           goes over when a robot drives into it. -->
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.004</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <!-- stem and stake only: the leaves do not stop a robot -->
      <collision name='collision'>
        <pose>0.015 0 0.300 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.04 0.600</size>
          </box>
        </geometry>
        <max_contacts>10</max_contacts>
        <surface>
          <contact>
            <ode/>
          </contact>
          <bounce/>
          <friction>
            <ode>
              <mu>10</mu>
              <mu2>10</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://tomato_01/meshes/tomato_01.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
    </link>
  </model>
</sdf>
