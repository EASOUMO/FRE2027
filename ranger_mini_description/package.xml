<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_mini_description</name>
  <version>0.1.0</version>
  <description>URDF description and Gazebo Harmonic simulation of the AgileX Ranger Mini (model from agilexrobotics/ugv_gazebo_sim, humble branch)</description>
  <maintainer email="emmanuel.soumo@gmail.com">Emmanuel Soumo</maintainer>
  <license>TODO: upstream repository declares no license</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hunter_se_description</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
